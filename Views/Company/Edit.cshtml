@model ManufacturerERP.Models.CompanySetting
@{ViewData["Title"]="Company Settings";}
<h2 class="mb-4">Company Settings</h2><form method="post" class="card"><div class="card-body"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="CompanyName"></label><input asp-for="CompanyName" class="form-control" /></div><div class="col-md-6"><label asp-for="LegalName"></label><input asp-for="LegalName" class="form-control" /></div><div class="col-md-4"><label asp-for="NTN"></label><input asp-for="NTN" class="form-control" /></div><div class="col-md-4"><label asp-for="STRN"></label><input asp-for="STRN" class="form-control" /></div><div class="col-md-4"><label asp-for="Phone"></label><input asp-for="Phone" class="form-control" /></div><div class="col-md-4"><label asp-for="Email"></label><input asp-for="Email" class="form-control" /></div><div class="col-md-4"><label asp-for="Currency"></label><input asp-for="Currency" class="form-control" /></div><div class="col-md-4"><label asp-for="CurrencySymbol"></label><input asp-for="CurrencySymbol" class="form-control" /></div><div class="col-md-6"><label asp-for="InvoicePrefix"></label><input asp-for="InvoicePrefix" class="form-control" /></div><div class="col-md-6"><label asp-for="PurchasePrefix"></label><input asp-for="PurchasePrefix" class="form-control" /></div><div class="col-md-6"><label asp-for="City"></label><input asp-for="City" class="form-control" /></div><div class="col-md-6"><label asp-for="Province"></label><input asp-for="Province" class="form-control" /></div><div class="col-12"><label asp-for="Address"></label><textarea asp-for="Address" class="form-control"></textarea></div></div></div><div class="card-footer text-end"><button class="btn btn-primary">Save settings</button></div></form>
