@model ManufacturerERP.Models.CustomerPayment
@{ ViewData["Title"]="Customer Payment"; var invoice=ViewBag.Invoice as ManufacturerERP.Models.CustomerInvoice; }
<div class="page-heading"><div><span class="eyebrow">RECEIVABLE</span><h1>Record Customer Payment</h1><p>@invoice?.Number · @invoice?.Customer?.Name</p></div></div>
<div class="alert alert-info">Invoice total: PKR @invoice?.GrandTotal.ToString("N2") · Paid: PKR @invoice?.PaidAmount.ToString("N2") · Outstanding: PKR @invoice?.OutstandingAmount.ToString("N2")</div>
<form method="post" asp-action="CreatePaymentForm"><input asp-for="CustomerInvoiceId" type="hidden"/><div asp-validation-summary="All" class="alert alert-danger"></div><section class="content-card mb-4"><div class="row g-3"><div class="col-md-4"><label asp-for="PaymentDate" class="form-label">Payment date</label><input asp-for="PaymentDate" type="date" class="form-control"/></div><div class="col-md-4"><label asp-for="Amount" class="form-label">Amount</label><input asp-for="Amount" type="number" min="0.01" max="@invoice?.OutstandingAmount" step="0.01" class="form-control"/><span asp-validation-for="Amount" class="text-danger"></span></div><div class="col-md-4"><label asp-for="PaymentMethod" class="form-label">Payment method</label><select asp-for="PaymentMethod" asp-items="Html.GetEnumSelectList<ManufacturerERP.Models.PaymentMethod>()" class="form-select"></select></div><div class="col-md-6"><label asp-for="ReferenceNumber" class="form-label">Reference</label><input asp-for="ReferenceNumber" class="form-control"/></div><div class="col-md-6"><label asp-for="Notes" class="form-label">Notes</label><input asp-for="Notes" class="form-control"/></div></div></section><button class="btn btn-primary">Record payment</button> <a asp-action="InvoiceDetails" asp-route-id="@Model.CustomerInvoiceId" class="btn btn-link">Cancel</a></form>
