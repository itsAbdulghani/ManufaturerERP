@using ManufacturerERP.Models
@{ ViewData["Title"]="Sales Reports"; var rows=ViewBag.Rows as IEnumerable<SalesReportRow> ?? []; var customers=ViewBag.Customers as IEnumerable<Customer> ?? []; var warehouses=ViewBag.Warehouses as IEnumerable<Warehouse> ?? []; }
<div class="page-heading"><div><span class="eyebrow">REPORTING</span><h1>Sales Reports</h1><p>Orders, dispatch value, payments, and receivables.</p></div></div>
<form class="content-card mb-4" method="get"><div class="row g-2 align-items-end"><div class="col-md-2"><label class="form-label">From</label><input name="fromDate" type="date" value="@Context.Request.Query["fromDate"]" class="form-control"/></div><div class="col-md-2"><label class="form-label">To</label><input name="toDate" type="date" value="@Context.Request.Query["toDate"]" class="form-control"/></div><div class="col-md-3"><label class="form-label">Customer</label><select name="customerId" class="form-select"><option value="">All customers</option>@foreach(var customer in customers){<option value="@customer.Id" selected="@(Context.Request.Query["customerId"]==customer.Id.ToString())">@customer.Name</option>}</select></div><div class="col-md-2"><label class="form-label">Warehouse</label><select name="warehouseId" class="form-select"><option value="">All warehouses</option>@foreach(var warehouse in warehouses){<option value="@warehouse.Id" selected="@(Context.Request.Query["warehouseId"]==warehouse.Id.ToString())">@warehouse.Name</option>}</select></div><div class="col-md-2"><label class="form-label">Status</label><select name="status" class="form-select"><option value="">All statuses</option>@foreach(var status in Enum.GetValues<SalesOrderStatus>()){<option value="@status" selected="@(Context.Request.Query["status"]==status.ToString())">@status</option>}</select></div><div class="col-md-1"><button class="btn btn-primary w-100">Filter</button></div></div></form>
<section class="content-card"><div class="table-responsive"><table class="table"><thead><tr><th>Order</th><th>Customer</th><th>Warehouse</th><th>Date</th><th>Quantity</th><th>Sales amount</th><th>Paid</th><th>Outstanding</th><th>Status</th></tr></thead><tbody>@foreach(var row in rows){<tr><td>@row.Number</td><td>@row.Customer</td><td>@row.Warehouse</td><td>@row.Date</td><td>@row.Quantity</td><td>PKR @row.Total.ToString("N2")</td><td>PKR @row.Paid.ToString("N2")</td><td>PKR @row.Outstanding.ToString("N2")</td><td>@row.Status</td></tr>}</tbody></table></div></section>
