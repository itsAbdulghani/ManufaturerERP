@model ManufacturerERP.Models.SalesOrder
@{ ViewData["Title"]=Model.Id==0?"New Sales Order":"Edit Sales Order"; var customers=ViewBag.Customers as IEnumerable<ManufacturerERP.Models.Customer> ?? []; var warehouses=ViewBag.Warehouses as IEnumerable<ManufacturerERP.Models.Warehouse> ?? []; var products=ViewBag.Products as IEnumerable<ManufacturerERP.Models.Product> ?? []; }
<div class="page-heading"><div><span class="eyebrow">SALES</span><h1>@ViewData["Title"]</h1><p>Draft and confirmed orders do not affect stock.</p></div></div>
<form method="post" asp-action="@(Model.Id==0?"CreateForm":"EditForm")" asp-route-id="@Model.Id"><div asp-validation-summary="All" class="alert alert-danger"></div><section class="content-card mb-4"><div class="row g-3"><div class="col-md-4"><label asp-for="CustomerId" class="form-label">Customer</label><select asp-for="CustomerId" class="form-select"><option value="">Select customer</option>@foreach(var customer in customers){<option value="@customer.Id">@customer.Code · @customer.Name</option>}</select><span asp-validation-for="CustomerId" class="text-danger"></span></div><div class="col-md-4"><label asp-for="WarehouseId" class="form-label">Warehouse</label><select asp-for="WarehouseId" class="form-select"><option value="">Select warehouse</option>@foreach(var warehouse in warehouses){<option value="@warehouse.Id">@warehouse.Name</option>}</select><span asp-validation-for="WarehouseId" class="text-danger"></span></div><div class="col-md-2"><label asp-for="OrderDate" class="form-label">Order date</label><input asp-for="OrderDate" type="date" class="form-control"/></div><div class="col-md-2"><label asp-for="RequestedDeliveryDate" class="form-label">Requested date</label><input asp-for="RequestedDeliveryDate" type="date" class="form-control"/></div><div class="col-md-4"><label asp-for="Reference" class="form-label">Reference</label><input asp-for="Reference" class="form-control"/></div><div class="col-md-4"><label asp-for="Discount" class="form-label">Order discount</label><input asp-for="Discount" type="number" min="0" step="0.01" class="form-control"/></div><div class="col-md-4"><label asp-for="Tax" class="form-label">Tax</label><input asp-for="Tax" type="number" min="0" step="0.01" class="form-control"/></div><div class="col-12"><label asp-for="Notes" class="form-label">Notes</label><textarea asp-for="Notes" class="form-control"></textarea></div></div></section>
<section class="content-card mb-4"><div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h5 mb-0">Finished goods</h2><button type="button" id="addLine" class="btn btn-outline-primary btn-sm">Add item</button></div><span asp-validation-for="Items" class="text-danger"></span><div id="items">@for(var i=0;i<Model.Items.Count;i++){<div class="row g-2 mb-2 item-row"><div class="col-md-5"><label class="form-label">Product</label><select name="Items[@i].ProductId" class="form-select" required><option value="">Select finished good</option>@foreach(var product in products){<option value="@product.Id" selected="@(product.Id==Model.Items[i].ProductId)">@product.Code · @product.Name (@product.Unit?.ShortCode)</option>}</select></div><div class="col-md-2"><label class="form-label">Quantity</label><input name="Items[@i].Quantity" value="@Model.Items[i].Quantity" type="number" min="0.001" step="0.001" class="form-control" required/></div><div class="col-md-2"><label class="form-label">Unit price</label><input name="Items[@i].UnitPrice" value="@Model.Items[i].UnitPrice" type="number" min="0" step="0.01" class="form-control" required/></div><div class="col-md-2"><label class="form-label">Discount</label><input name="Items[@i].Discount" value="@Model.Items[i].Discount" type="number" min="0" step="0.01" class="form-control"/></div><div class="col-md-1 d-flex align-items-end"><button type="button" class="btn btn-outline-secondary remove-line">Remove</button></div></div>}</div></section><button class="btn btn-primary">@(Model.Id==0?"Create draft":"Save draft")</button> <a asp-action="Index" class="btn btn-link">Cancel</a></form>
@section Scripts { <script>
const productOptions=`@Html.Raw(string.Join("",products.Select(p=>$"<option value=\"{p.Id}\">{System.Net.WebUtility.HtmlEncode(p.Code)} · {System.Net.WebUtility.HtmlEncode(p.Name)} ({System.Net.WebUtility.HtmlEncode(p.Unit?.ShortCode??"")})</option>")))`;
function reindex(){document.querySelectorAll('#items .item-row').forEach((row,index)=>row.querySelectorAll('[name]').forEach(input=>input.name=input.name.replace(/Items\[\d+\]/,`Items[${index}]`)));}
document.querySelector('#addLine').addEventListener('click',()=>{const index=document.querySelectorAll('#items .item-row').length;document.querySelector('#items').insertAdjacentHTML('beforeend',`<div class="row g-2 mb-2 item-row"><div class="col-md-5"><label class="form-label">Product</label><select name="Items[${index}].ProductId" class="form-select" required><option value="">Select finished good</option>${productOptions}</select></div><div class="col-md-2"><label class="form-label">Quantity</label><input name="Items[${index}].Quantity" type="number" min="0.001" step="0.001" class="form-control" required/></div><div class="col-md-2"><label class="form-label">Unit price</label><input name="Items[${index}].UnitPrice" type="number" min="0" step="0.01" class="form-control" required/></div><div class="col-md-2"><label class="form-label">Discount</label><input name="Items[${index}].Discount" value="0" type="number" min="0" step="0.01" class="form-control"/></div><div class="col-md-1 d-flex align-items-end"><button type="button" class="btn btn-outline-secondary remove-line">Remove</button></div></div>`);});
document.querySelector('#items').addEventListener('click',event=>{if(event.target.closest('.remove-line')){event.target.closest('.item-row').remove();reindex();}});
</script> }
