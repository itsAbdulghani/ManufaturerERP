@model IEnumerable<ManufacturerERP.Models.SalesOrder>
@{ ViewData["Title"]="Sales Orders"; var customers=ViewBag.Customers as IEnumerable<ManufacturerERP.Models.Customer> ?? []; var warehouses=ViewBag.Warehouses as IEnumerable<ManufacturerERP.Models.Warehouse> ?? []; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><h2>Sales Orders</h2><p class="text-muted mb-0">Only completed dispatches deduct finished-goods stock.</p></div><div class="d-flex gap-2"><a asp-action="Invoices" class="btn btn-outline-primary">Receivables</a><a asp-action="Payments" class="btn btn-outline-primary">Payments</a><a asp-action="Reports" class="btn btn-outline-primary">Reports</a>@if(User.IsInRole("Admin")||User.IsInRole("Manager")||User.IsInRole("Sales")){<a asp-action="Create" class="btn btn-primary">New sales order</a>}</div></div>
@if(TempData["Success"] is string success){<div class="alert alert-success">@success</div>}@if(TempData["Error"] is string error){<div class="alert alert-danger">@error</div>}
<form class="content-card mb-4" method="get"><div class="row g-2 align-items-end"><div class="col-lg-3"><label class="form-label">Search</label><input name="search" value="@Context.Request.Query["search"]" class="form-control" placeholder="Order, customer, reference"/></div><div class="col-lg-2"><label class="form-label">Status</label><select name="status" class="form-select"><option value="">All statuses</option>@foreach(var status in Enum.GetValues<ManufacturerERP.Models.SalesOrderStatus>()){<option value="@status" selected="@(Context.Request.Query["status"]==status.ToString())">@status</option>}</select></div><div class="col-lg-2"><label class="form-label">Customer</label><select name="customerId" class="form-select"><option value="">All customers</option>@foreach(var customer in customers){<option value="@customer.Id" selected="@(Context.Request.Query["customerId"]==customer.Id.ToString())">@customer.Name</option>}</select></div><div class="col-lg-2"><label class="form-label">Warehouse</label><select name="warehouseId" class="form-select"><option value="">All warehouses</option>@foreach(var warehouse in warehouses){<option value="@warehouse.Id" selected="@(Context.Request.Query["warehouseId"]==warehouse.Id.ToString())">@warehouse.Name</option>}</select></div><div class="col-lg-1"><label class="form-label">From</label><input type="date" name="fromDate" value="@Context.Request.Query["fromDate"]" class="form-control"/></div><div class="col-lg-1"><label class="form-label">To</label><input type="date" name="toDate" value="@Context.Request.Query["toDate"]" class="form-control"/></div><div class="col-lg-1"><button class="btn btn-primary w-100">Filter</button></div></div></form>
<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Order</th><th>Customer</th><th>Warehouse</th><th>Date</th><th>Total</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var order in Model){<tr><td><a asp-action="Details" asp-route-id="@order.Id">@order.Number</a></td><td>@order.Customer?.Name</td><td>@order.Warehouse?.Name</td><td>@order.OrderDate</td><td>PKR @order.GrandTotal.ToString("N2")</td><td>@order.Status</td><td><a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">Open</a></td></tr>}</tbody></table></div></div>
