@model ManufacturerERP.Models.SalesOrder
@{ ViewData["Title"]="Sales Order"; var transactions=ViewBag.Transactions as IEnumerable<ManufacturerERP.Models.InventoryTransaction> ?? []; var invoice=Model.Invoice; var canSales=User.IsInRole("Admin")||User.IsInRole("Manager")||User.IsInRole("Sales"); var canDispatch=canSales||User.IsInRole("Storekeeper"); }
<div class="page-heading"><div><span class="eyebrow">@Model.Status</span><h1>@Model.Number</h1><p>@Model.Customer?.Name · @Model.Warehouse?.Name · @Model.OrderDate</p></div><div class="d-flex gap-2">@if(Model.Status==ManufacturerERP.Models.SalesOrderStatus.Draft&&canSales){<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Edit draft</a>}@if(Model.Status==ManufacturerERP.Models.SalesOrderStatus.Draft&&canSales){<form method="post" asp-action="Confirm" asp-route-id="@Model.Id"><button class="btn btn-primary">Confirm</button></form>}@if(Model.Status==ManufacturerERP.Models.SalesOrderStatus.Confirmed&&canDispatch){<form method="post" asp-action="Complete" asp-route-id="@Model.Id"><button class="btn btn-primary">Complete / Dispatch</button></form>}</div></div>
@if(TempData["Success"] is string success){<div class="alert alert-success">@success</div>}@if(TempData["Error"] is string error){<div class="alert alert-danger">@error</div>}
<section class="content-card mb-4"><h2 class="h5">Items</h2><div class="table-responsive"><table class="table"><thead><tr><th>Finished good</th><th>Unit</th><th>Quantity</th><th>Unit price</th><th>Discount</th><th>Line total</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td>@item.Product?.Name</td><td>@item.Unit?.ShortCode</td><td>@item.Quantity</td><td>PKR @item.UnitPrice.ToString("N2")</td><td>PKR @item.Discount.ToString("N2")</td><td>PKR @item.LineTotal.ToString("N2")</td></tr>}</tbody><tfoot><tr><th colspan="5" class="text-end">Subtotal / discount / tax / total</th><th>PKR @Model.Subtotal.ToString("N2") / PKR @Model.Discount.ToString("N2") / PKR @Model.Tax.ToString("N2") / PKR @Model.GrandTotal.ToString("N2")</th></tr></tfoot></table></div><p class="text-muted mb-0">Draft and confirmed orders do not affect stock. Dispatch deducts finished goods and creates the receivable.</p></section>
@if(invoice is not null){<section class="content-card mb-4"><div class="d-flex justify-content-between align-items-center"><h2 class="h5 mb-0">Customer invoice</h2><a asp-action="InvoiceDetails" asp-route-id="@invoice.Id" class="btn btn-sm btn-outline-primary">@invoice.Number · @invoice.Status</a></div><p class="mb-0 mt-3">Grand total PKR @invoice.GrandTotal.ToString("N2") · Paid PKR @invoice.PaidAmount.ToString("N2") · Outstanding PKR @invoice.OutstandingAmount.ToString("N2")</p></section>}
<section class="content-card"><h2 class="h5">Inventory impact</h2>@if(!transactions.Any()){<p class="text-muted mb-0">No stock movement recorded.</p>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Date</th><th>Finished good</th><th>Quantity out</th><th>Warehouse</th><th>Reference</th></tr></thead><tbody>@foreach(var transaction in transactions){<tr><td>@transaction.TransactionDate</td><td>@transaction.Product?.Name</td><td>@(-transaction.Quantity)</td><td>@Model.Warehouse?.Name</td><td>@transaction.ReferenceType #@transaction.ReferenceId</td></tr>}</tbody></table></div>}</section>
