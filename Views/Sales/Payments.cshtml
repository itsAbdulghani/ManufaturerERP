@model IEnumerable<ManufacturerERP.Models.CustomerPayment>
@{ ViewData["Title"]="Customer Payments"; var customers=ViewBag.Customers as IEnumerable<ManufacturerERP.Models.Customer> ?? []; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><h2>Customer Payments</h2><p class="text-muted mb-0">Payment history against dispatched sales invoices.</p></div><a asp-action="Invoices" class="btn btn-outline-primary">Receivables</a></div>
<form class="content-card mb-4" method="get"><div class="row g-2 align-items-end"><div class="col-md-5"><label class="form-label">Search</label><input name="search" value="@Context.Request.Query["search"]" class="form-control" placeholder="Payment, customer, reference"/></div><div class="col-md-3"><label class="form-label">Customer</label><select name="customerId" class="form-select"><option value="">All customers</option>@foreach(var customer in customers){<option value="@customer.Id" selected="@(Context.Request.Query["customerId"]==customer.Id.ToString())">@customer.Name</option>}</select></div><div class="col-md-1"><label class="form-label">From</label><input name="fromDate" type="date" value="@Context.Request.Query["fromDate"]" class="form-control"/></div><div class="col-md-1"><label class="form-label">To</label><input name="toDate" type="date" value="@Context.Request.Query["toDate"]" class="form-control"/></div><div class="col-md-2"><button class="btn btn-primary w-100">Filter</button></div></div></form>
<div class="card"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Payment</th><th>Invoice</th><th>Customer</th><th>Date</th><th>Method</th><th>Reference</th><th>Amount</th></tr></thead><tbody>@foreach(var payment in Model){<tr><td>@payment.Number</td><td><a asp-action="InvoiceDetails" asp-route-id="@payment.CustomerInvoiceId">@payment.CustomerInvoice?.Number</a></td><td>@payment.Customer?.Name</td><td>@payment.PaymentDate</td><td>@payment.PaymentMethod</td><td>@payment.ReferenceNumber</td><td>PKR @payment.Amount.ToString("N2")</td></tr>}</tbody></table></div></div>
