@model ManufacturerERP.Models.CustomerInvoice
@{ ViewData["Title"]="Customer Invoice"; }
<div class="page-heading"><div><span class="eyebrow">@Model.Status</span><h1>@Model.Number</h1><p>@Model.Customer?.Name · Sales order @Model.SalesOrder?.Number · @Model.InvoiceDate</p></div>@if(Model.Status is ManufacturerERP.Models.CustomerInvoiceStatus.Unpaid or ManufacturerERP.Models.CustomerInvoiceStatus.PartiallyPaid){<a asp-action="CreatePayment" asp-route-invoiceId="@Model.Id" class="btn btn-primary">Record payment</a>}</div>
@if(TempData["Success"] is string success){<div class="alert alert-success">@success</div>}
<section class="content-card mb-4"><div class="row g-3"><div class="col-md-3"><span class="text-muted">Subtotal</span><div>PKR @Model.Subtotal.ToString("N2")</div></div><div class="col-md-3"><span class="text-muted">Discount</span><div>PKR @Model.Discount.ToString("N2")</div></div><div class="col-md-3"><span class="text-muted">Tax</span><div>PKR @Model.Tax.ToString("N2")</div></div><div class="col-md-3"><span class="text-muted">Grand total</span><div class="fw-semibold">PKR @Model.GrandTotal.ToString("N2")</div></div><div class="col-md-3"><span class="text-muted">Paid</span><div>PKR @Model.PaidAmount.ToString("N2")</div></div><div class="col-md-3"><span class="text-muted">Outstanding</span><div>PKR @Model.OutstandingAmount.ToString("N2")</div></div><div class="col-md-3"><span class="text-muted">Due date</span><div>@Model.DueDate</div></div></div></section>
<section class="content-card"><h2 class="h5">Payments</h2>@if(!Model.Payments.Any()){<p class="text-muted mb-0">No payments recorded.</p>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Payment</th><th>Date</th><th>Method</th><th>Reference</th><th>Amount</th></tr></thead><tbody>@foreach(var payment in Model.Payments.OrderBy(x=>x.PaymentDate)){<tr><td>@payment.Number</td><td>@payment.PaymentDate</td><td>@payment.PaymentMethod</td><td>@payment.ReferenceNumber</td><td>PKR @payment.Amount.ToString("N2")</td></tr>}</tbody></table></div>}</section>
