@model IEnumerable<ManufacturerERP.Models.CustomerInvoice>
@{ ViewData["Title"]="Customer Receivables"; var customers=ViewBag.Customers as IEnumerable<ManufacturerERP.Models.Customer> ?? []; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><h2>Customer Receivables</h2><p class="text-muted mb-0">Invoices are created on dispatch; payments do not affect stock.</p></div><a asp-action="Payments" class="btn btn-outline-primary">Payments</a></div>
@if(TempData["Success"] is string success){<div class="alert alert-success">@success</div>}
<form class="content-card mb-4" method="get"><div class="row g-2 align-items-end"><div class="col-md-5"><label class="form-label">Search</label><input name="search" value="@Context.Request.Query["search"]" class="form-control" placeholder="Invoice, order, customer"/></div><div class="col-md-3"><label class="form-label">Customer</label><select name="customerId" class="form-select"><option value="">All customers</option>@foreach(var customer in customers){<option value="@customer.Id" selected="@(Context.Request.Query["customerId"]==customer.Id.ToString())">@customer.Name</option>}</select></div><div class="col-md-3"><label class="form-label">Status</label><select name="status" class="form-select"><option value="">All statuses</option>@foreach(var status in Enum.GetValues<ManufacturerERP.Models.CustomerInvoiceStatus>()){<option value="@status" selected="@(Context.Request.Query["status"]==status.ToString())">@status</option>}</select></div><div class="col-md-1"><button class="btn btn-primary w-100">Filter</button></div></div></form>
<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Invoice</th><th>Customer</th><th>Sales order</th><th>Date</th><th>Total</th><th>Paid</th><th>Outstanding</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var invoice in Model){<tr><td><a asp-action="InvoiceDetails" asp-route-id="@invoice.Id">@invoice.Number</a></td><td>@invoice.Customer?.Name</td><td>@invoice.SalesOrder?.Number</td><td>@invoice.InvoiceDate</td><td>PKR @invoice.GrandTotal.ToString("N2")</td><td>PKR @invoice.PaidAmount.ToString("N2")</td><td>PKR @invoice.OutstandingAmount.ToString("N2")</td><td>@invoice.Status</td><td><a asp-action="InvoiceDetails" asp-route-id="@invoice.Id" class="btn btn-sm btn-outline-primary">Open</a></td></tr>}</tbody></table></div></div>
