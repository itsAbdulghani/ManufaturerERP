@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-heading"><div><span class="eyebrow">OPERATIONS OVERVIEW</span><h1>Welcome back</h1><p>Manage your manufacturing operations from one workspace.</p></div><a class="btn btn-primary" href="/Masters/products">Manage products</a></div>
<div class="row g-4"><div class="col-sm-6 col-xl-3"><div class="metric-card"><span class="metric-label">Productions today</span><strong>@ViewBag.ProductionsToday</strong><small>Orders dated today</small></div></div><div class="col-sm-6 col-xl-3"><div class="metric-card"><span class="metric-label">In progress</span><strong>@ViewBag.ProductionsInProgress</strong><small>Active production orders</small></div></div><div class="col-sm-6 col-xl-3"><div class="metric-card"><span class="metric-label">Completed</span><strong>@ViewBag.ProductionsCompleted</strong><small>Completed production orders</small></div></div><div class="col-sm-6 col-xl-3"><div class="metric-card"><span class="metric-label">Produced quantity</span><strong>@ViewBag.ProducedQuantity</strong><small>Actual finished output</small></div></div></div>
<div class="row g-4 mt-1"><div class="col-sm-6 col-xl-3"><div class="metric-card"><span class="metric-label">Production cost</span><strong>PKR @Convert.ToDecimal(ViewBag.ProductionCost).ToString("N2")</strong><small>Completed material cost</small></div></div><div class="col-sm-6 col-xl-3"><div class="metric-card"><span class="metric-label">Low raw stock</span><strong>@ViewBag.LowRawStock</strong><small>Items at or below minimum</small></div></div><div class="col-sm-6 col-xl-3"><div class="metric-card"><span class="metric-label">Finished goods stock</span><strong>@ViewBag.FinishedGoodsStock</strong><small>Current transaction balance</small></div></div><div class="col-sm-6 col-xl-3"><div class="metric-card"><span class="metric-label">Products</span><strong>@ViewBag.ActiveProducts</strong><small>Active catalogue items</small></div></div></div>
<div class="row g-4 mt-1"><div class="col-sm-6 col-xl-3"><div class="metric-card"><span class="metric-label">Sales orders</span><strong>@ViewBag.SalesOrderCount</strong><small><a href="/Sales">Open orders</a></small></div></div><div class="col-sm-6 col-xl-3"><div class="metric-card"><span class="metric-label">Completed sales</span><strong>@ViewBag.CompletedSalesCount</strong><small>@ViewBag.CompletedSalesQuantity units dispatched</small></div></div><div class="col-sm-6 col-xl-3"><div class="metric-card"><span class="metric-label">Sales amount</span><strong>PKR @Convert.ToDecimal(ViewBag.SalesAmount).ToString("N2")</strong><small>Completed customer invoices</small></div></div><div class="col-sm-6 col-xl-3"><div class="metric-card"><span class="metric-label">Customer receivables</span><strong>PKR @Convert.ToDecimal(ViewBag.OutstandingReceivables).ToString("N2")</strong><small><a href="/Sales/Invoices">View receivables</a></small></div></div></div>
<div class="row g-4 mt-1"><div class="col-lg-8"><section class="content-card"><h2>Getting started</h2><p>Build your purchasing and manufacturing workflow in the correct order.</p><div class="workflow-steps"><a href="/Masters/suppliers"><b>01</b><span><strong>Add suppliers</strong><small>Maintain trusted vendor records</small></span></a><a href="/Masters/products"><b>02</b><span><strong>Add raw materials</strong><small>Set SKU, unit and minimum stock</small></span></a><a href="/Procurement"><b>03</b><span><strong>Receive inventory</strong><small>Post warehouse stock through purchasing</small></span></a><a href="/Production"><b>04</b><span><strong>Run production</strong><small>Consume materials and post finished goods</small></span></a></div></section></div><div class="col-lg-4"><section class="content-card accent-card"><span class="eyebrow">MANUFACTURING</span><h2>Production</h2><p>Plan orders, consume warehouse materials, and post actual finished output.</p><a href="/Production" class="btn btn-light">Open production</a></section></div></div>
