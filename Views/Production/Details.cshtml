@model ManufacturerERP.Models.ProductionOrder
@{ ViewData["Title"] = "Production Order"; var transactions = ViewBag.Transactions as IEnumerable<ManufacturerERP.Models.InventoryTransaction> ?? []; }
<div class="page-heading"><div><span class="eyebrow">@Model.Status</span><h1>@Model.Number</h1><p>@Model.Product?.Name · @Model.Warehouse?.Name · @Model.ProductionDate</p></div><div class="d-flex gap-2">@if (Model.Status == ManufacturerERP.Models.ProductionOrderStatus.Draft) { <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Edit draft</a><form method="post" asp-action="Plan" asp-route-id="@Model.Id"><button class="btn btn-primary">Plan</button></form> } else if (Model.Status == ManufacturerERP.Models.ProductionOrderStatus.Planned) { <form method="post" asp-action="Start" asp-route-id="@Model.Id"><button class="btn btn-primary">Start production</button></form> }</div></div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> } @if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
<div class="row g-4"><div class="col-lg-8"><section class="content-card"><h2>Materials</h2><div class="table-responsive"><table class="table"><thead><tr><th>Material</th><th>Unit</th><th>Planned</th><th>Consumed</th><th>Unit cost</th><th>Total cost</th><th></th></tr></thead><tbody>@foreach (var m in Model.Materials) { <tr><td>@m.Product?.Name</td><td>@m.Unit?.ShortCode</td><td>@m.PlannedQuantity</td><td>@m.ConsumedQuantity</td><td>PKR @m.UnitCost.ToString("N2")</td><td>PKR @m.TotalCost.ToString("N2")</td><td>@if (Model.Status == ManufacturerERP.Models.ProductionOrderStatus.InProgress) { <form method="post" asp-action="Consume" asp-route-id="@Model.Id" class="d-flex gap-1"><input type="hidden" name="materialId" value="@m.Id" /><input name="consumedQuantity" type="number" min="0.001" max="@m.PlannedQuantity" step="0.001" class="form-control form-control-sm" placeholder="Qty" required /><button class="btn btn-sm btn-outline-primary">Consume</button></form> }</td></tr> }</tbody></table></div></section></div><div class="col-lg-4"><section class="content-card"><h2>Production Summary</h2><p>Planned quantity: <strong>@Model.PlannedQuantity</strong></p><p>Actual quantity: <strong>@Model.ActualQuantity</strong></p><p>Wastage: <strong>@Model.WastageQuantity</strong></p><p>Material cost: <strong>PKR @Model.MaterialCost.ToString("N2")</strong></p><p>Cost per produced unit: <strong>PKR @(Model.ActualQuantity == 0 ? 0 : Model.MaterialCost / Model.ActualQuantity)</strong></p>@if (Model.Status == ManufacturerERP.Models.ProductionOrderStatus.InProgress) { <hr /><h2>Complete production</h2><form method="post" asp-action="Complete" asp-route-id="@Model.Id"><label class="form-label">Actual produced quantity</label><input name="actualQuantity" type="number" min="0.001" max="@Model.PlannedQuantity" step="0.001" class="form-control mb-2" required /><label class="form-label">Wastage quantity</label><input name="wastageQuantity" type="number" min="0" max="@Model.PlannedQuantity" step="0.001" value="0" class="form-control mb-2" required /><textarea name="notes" class="form-control mb-2" placeholder="Completion notes"></textarea><button class="btn btn-primary w-100">Complete and post output</button></form> }</section></div></div><section class="content-card mt-4"><h2>Inventory Impact</h2><ul class="mb-0">@foreach (var t in transactions) { <li>@t.TransactionType: @t.Product?.Name · @t.Quantity · @t.TransactionDate</li> }</ul></section>
