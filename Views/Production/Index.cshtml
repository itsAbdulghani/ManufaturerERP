@model IEnumerable<ManufacturerERP.Models.ProductionOrder>
@{ ViewData["Title"] = "Production Orders"; var products = ViewBag.Products as IEnumerable<ManufacturerERP.Models.Product> ?? []; var warehouses = ViewBag.Warehouses as IEnumerable<ManufacturerERP.Models.Warehouse> ?? []; }
<div class="page-heading"><div><span class="eyebrow">MANUFACTURING</span><h1>Production Orders</h1><p>Plan, consume materials, and post finished goods output.</p></div><div class="d-flex gap-2"><a class="btn btn-outline-primary" asp-action="Reports">Reports</a><a class="btn btn-primary" asp-action="Create">+ New production</a></div></div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> } @if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
<form class="content-card mb-4" method="get"><div class="row g-2 align-items-end"><div class="col-lg-3"><label class="form-label">Search</label><input name="search" value="@Context.Request.Query["search"]" class="form-control" placeholder="Number or product" /></div><div class="col-lg-2"><label class="form-label">Status</label><select name="status" class="form-select"><option value="">All statuses</option>@foreach (var item in Enum.GetValues<ManufacturerERP.Models.ProductionOrderStatus>()) { <option value="@item">@item</option> }</select></div><div class="col-lg-2"><label class="form-label">Product</label><select name="productId" class="form-select"><option value="">All products</option>@foreach (var product in products.Where(x => x.ItemType == ManufacturerERP.Models.ItemType.FinishedGood)) { <option value="@product.Id">@product.Name</option> }</select></div><div class="col-lg-2"><label class="form-label">Warehouse</label><select name="warehouseId" class="form-select"><option value="">All warehouses</option>@foreach (var warehouse in warehouses) { <option value="@warehouse.Id">@warehouse.Name</option> }</select></div><div class="col-lg-1"><label class="form-label">From</label><input type="date" name="fromDate" class="form-control" /></div><div class="col-lg-1"><label class="form-label">To</label><input type="date" name="toDate" class="form-control" /></div><div class="col-lg-1"><button class="btn btn-primary w-100">Filter</button></div></div></form>
<div class="card"><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Production No.</th><th>Finished Product</th><th>Warehouse</th><th>Planned</th><th>Actual</th><th>Wastage</th><th>Date</th><th>Status</th></tr></thead><tbody>@foreach (var x in Model) { <tr><td><a asp-action="Details" asp-route-id="@x.Id">@x.Number</a></td><td>@x.Product?.Name</td><td>@x.Warehouse?.Name</td><td>@x.PlannedQuantity</td><td>@x.ActualQuantity</td><td>@x.WastageQuantity</td><td>@x.ProductionDate</td><td><span class="badge text-bg-light">@x.Status</span></td></tr> }</tbody></table></div></div>
