@model ManufacturerERP.Models.ProductionOrder
@{ ViewData["Title"] = "Edit Production Order"; var products = ViewBag.Products as IEnumerable<ManufacturerERP.Models.Product> ?? []; var warehouses = ViewBag.Warehouses as IEnumerable<ManufacturerERP.Models.Warehouse> ?? []; }
<div class="page-heading"><div><span class="eyebrow">DRAFT</span><h1>Edit @Model.Number</h1></div></div>
<form method="post" asp-action="EditForm" asp-route-id="@Model.Id"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="content-card mb-4"><div class="row g-3"><div class="col-md-4"><label asp-for="ProductId" class="form-label">Finished product</label><select asp-for="ProductId" class="form-select">@foreach (var product in products.Where(x => x.ItemType == ManufacturerERP.Models.ItemType.FinishedGood)) { <option value="@product.Id">@product.Name</option> }</select></div><div class="col-md-4"><label asp-for="WarehouseId" class="form-label">Warehouse</label><select asp-for="WarehouseId" class="form-select">@foreach (var warehouse in warehouses) { <option value="@warehouse.Id">@warehouse.Name</option> }</select></div><div class="col-md-2"><label asp-for="PlannedQuantity" class="form-label">Planned quantity</label><input asp-for="PlannedQuantity" class="form-control" min="0.001" step="0.001" /><span asp-validation-for="PlannedQuantity" class="text-danger"></span></div><div class="col-md-2"><label asp-for="ProductionDate" class="form-label">Production date</label><input asp-for="ProductionDate" class="form-control" /></div><div class="col-12"><label asp-for="Notes" class="form-label">Notes</label><textarea asp-for="Notes" class="form-control"></textarea></div></div></div><div class="content-card mb-4"><h2>Materials</h2>@for (var i = 0; i < Model.Materials.Count; i++) { <div class="row g-2 mb-2"><div class="col-md-5"><select name="Materials[@i].ProductId" class="form-select">@foreach (var product in products.Where(x => x.ItemType is ManufacturerERP.Models.ItemType.RawMaterial or ManufacturerERP.Models.ItemType.Consumable)) { <option value="@product.Id" selected="@(product.Id == Model.Materials[i].ProductId)">@product.Name</option> }</select></div><div class="col-md-3"><input name="Materials[@i].PlannedQuantity" value="@Model.Materials[i].PlannedQuantity" class="form-control" type="number" min="0.001" step="0.001" /></div><div class="col-md-3"><input name="Materials[@i].UnitCost" value="@Model.Materials[i].UnitCost" class="form-control" type="number" min="0" step="0.01" /></div></div>}</div><button class="btn btn-primary">Save draft</button> <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link">Cancel</a></form>
