@model IEnumerable<ManufacturerERP.Models.PurchaseOrder>
@{ViewData["Title"]="Purchase Orders";}
<div class="d-flex justify-content-between align-items-center mb-4"><div><h2>Purchase Orders</h2><p class="text-muted mb-0">Draft and approved orders do not affect inventory.</p></div><div class="d-flex gap-2">@if(User.IsInRole("Admin")||User.IsInRole("Manager")||User.IsInRole("Purchase")||User.IsInRole("Accountant")){<a asp-action="Invoices" class="btn btn-outline-primary">Purchase invoices</a>}<a asp-action="Inventory" class="btn btn-outline-primary">Inventory</a>@if(User.IsInRole("Admin")||User.IsInRole("Manager")||User.IsInRole("Purchase")){<a asp-action="CreateOrder" class="btn btn-primary">New purchase order</a>}</div></div>
@if(TempData["Success"] is string success){<div class="alert alert-success">@success</div>}
<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Number</th><th>Supplier</th><th>Warehouse</th><th>Date</th><th>Total</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var po in Model){<tr><td><a asp-action="OrderDetails" asp-route-id="@po.Id">@po.Number</a></td><td>@po.Supplier?.Name</td><td>@po.Warehouse?.Name</td><td>@po.OrderDate.ToString("dd MMM yyyy")</td><td>PKR @po.GrandTotal.ToString("N2")</td><td>@po.Status</td><td><a asp-action="OrderDetails" asp-route-id="@po.Id" class="btn btn-sm btn-outline-primary">Open</a></td></tr>}</tbody></table></div></div>
