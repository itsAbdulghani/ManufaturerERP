@model IEnumerable<ManufacturerERP.Models.PurchaseInvoice>
@{ ViewData["Title"]="Purchase Invoices"; var canCreate=User.IsInRole("Admin")||User.IsInRole("Manager")||User.IsInRole("Purchase")||User.IsInRole("Accountant"); var canPay=User.IsInRole("Admin")||User.IsInRole("Manager")||User.IsInRole("Accountant"); }
<div class="d-flex justify-content-between align-items-center mb-4"><div><h2>Purchase Invoices</h2><p class="text-muted mb-0">Invoices create payables when confirmed and do not post stock.</p></div>@if(canCreate){<a asp-action="CreateInvoice" class="btn btn-primary">New invoice</a>}</div>
@if(TempData["Success"] is string success){<div class="alert alert-success">@success</div>}@if(TempData["Error"] is string error){<div class="alert alert-danger">@error</div>}
<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Number</th><th>Supplier</th><th>PO</th><th>Date</th><th>Total</th><th>Paid</th><th>Outstanding</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach(var invoice in Model){var paid=invoice.Payments.Sum(x=>x.Amount);var outstanding=invoice.GrandTotal-paid;<tr><td>@invoice.Number</td><td>@invoice.Supplier?.Name</td><td>@invoice.PurchaseOrder?.Number</td><td>@invoice.InvoiceDate</td><td>PKR @invoice.GrandTotal.ToString("N2")</td><td>PKR @paid.ToString("N2")</td><td>PKR @outstanding.ToString("N2")</td><td>@invoice.Status</td><td class="text-nowrap">@if(canCreate&&invoice.Status==ManufacturerERP.Models.PurchaseInvoiceStatus.Draft){<form method="post" asp-action="ConfirmInvoiceForm" class="d-inline"><input type="hidden" name="id" value="@invoice.Id"/><button class="btn btn-sm btn-primary">Confirm</button></form>}@if(canPay&&(invoice.Status is ManufacturerERP.Models.PurchaseInvoiceStatus.Confirmed or ManufacturerERP.Models.PurchaseInvoiceStatus.PartiallyPaid)){<a asp-action="RecordPayment" asp-route-invoiceId="@invoice.Id" class="btn btn-sm btn-outline-primary">Record payment</a>}</td></tr>}</tbody></table></div></div>
