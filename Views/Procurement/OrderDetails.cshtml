@model ManufacturerERP.Models.PurchaseOrder
@{ ViewData["Title"] = "Purchase Order"; var receipts=ViewBag.Receipts as IEnumerable<ManufacturerERP.Models.GoodsReceipt> ?? []; var invoices=ViewBag.Invoices as IEnumerable<ManufacturerERP.Models.PurchaseInvoice> ?? []; var canPurchase=User.IsInRole("Admin")||User.IsInRole("Manager")||User.IsInRole("Purchase"); var canApprove=User.IsInRole("Admin")||User.IsInRole("Manager"); var canReceive=User.IsInRole("Admin")||User.IsInRole("Manager")||User.IsInRole("Storekeeper"); var canInvoice=canPurchase||User.IsInRole("Accountant"); }
<div class="page-heading"><div><span class="eyebrow">@Model.Status</span><h1>@Model.Number</h1><p>@Model.Supplier?.Name · @Model.Warehouse?.Name · @Model.OrderDate</p></div><div class="d-flex gap-2">@if(Model.Status==ManufacturerERP.Models.PurchaseOrderStatus.Draft){if(canPurchase){<a asp-action="EditOrder" asp-route-id="@Model.Id" class="btn btn-outline-primary">Edit draft</a>}if(canApprove){<form method="post" asp-action="ApproveOrderForm" asp-route-id="@Model.Id"><button class="btn btn-primary">Approve</button></form>}}@if(canReceive&&(Model.Status is ManufacturerERP.Models.PurchaseOrderStatus.Approved or ManufacturerERP.Models.PurchaseOrderStatus.PartiallyReceived)){<a asp-action="CreateReceipt" asp-route-id="@Model.Id" class="btn btn-primary">Receive goods</a>}</div></div>
@if(TempData["Success"] is string success){<div class="alert alert-success">@success</div>}@if(TempData["Error"] is string error){<div class="alert alert-danger">@error</div>}
<section class="content-card mb-4"><h2 class="h5">Items</h2><div class="table-responsive"><table class="table"><thead><tr><th>Product</th><th>Unit</th><th>Ordered</th><th>Received</th><th>Open</th><th>Unit price</th><th>Total</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td>@item.Product?.Name</td><td>@item.Unit?.ShortCode</td><td>@item.Quantity</td><td>@item.ReceivedQuantity</td><td>@(item.Quantity-item.ReceivedQuantity)</td><td>PKR @item.UnitPrice.ToString("N2")</td><td>PKR @item.LineTotal.ToString("N2")</td></tr>}</tbody><tfoot><tr><th colspan="6" class="text-end">Grand total</th><th>PKR @Model.GrandTotal.ToString("N2")</th></tr></tfoot></table></div><p class="text-muted mb-0">Draft and approved orders do not change inventory.</p></section>
<section class="content-card mb-4"><h2 class="h5">Goods receipts</h2>@if(!receipts.Any()){<p class="text-muted mb-0">No receipts recorded.</p>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Receipt</th><th>Date</th><th>Delivery note</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var receipt in receipts){<tr><td>@receipt.Number</td><td>@receipt.ReceiptDate</td><td>@receipt.SupplierDeliveryNoteNumber</td><td>@receipt.Status</td><td>@if(canReceive&&receipt.Status==ManufacturerERP.Models.GoodsReceiptStatus.Draft){<form method="post" asp-action="ConfirmReceiptForm"><input type="hidden" name="id" value="@receipt.Id"/><input type="hidden" name="orderId" value="@Model.Id"/><button class="btn btn-sm btn-primary">Confirm receipt</button></form>}</td></tr>}</tbody></table></div>}</section>
<section class="content-card"><div class="d-flex justify-content-between"><h2 class="h5">Purchase invoices</h2>@if(canInvoice){<a asp-action="CreateInvoice" asp-route-purchaseOrderId="@Model.Id" class="btn btn-sm btn-outline-primary">Create invoice</a>}</div>@if(!invoices.Any()){<p class="text-muted mb-0">No invoices linked to this order.</p>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Invoice</th><th>Date</th><th>Total</th><th>Status</th></tr></thead><tbody>@foreach(var invoice in invoices){<tr><td>@invoice.Number</td><td>@invoice.InvoiceDate</td><td>PKR @invoice.GrandTotal.ToString("N2")</td><td>@invoice.Status</td></tr>}</tbody></table></div>}</section>
