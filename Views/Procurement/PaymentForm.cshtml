@model ManufacturerERP.Models.SupplierPayment
@{ ViewData["Title"]="Supplier Payment"; var invoice=ViewBag.Invoice as ManufacturerERP.Models.PurchaseInvoice; decimal outstanding=ViewBag.Outstanding is decimal amount?amount:0; }
<div class="page-heading"><div><span class="eyebrow">PAYABLE</span><h1>Record Supplier Payment</h1><p>@invoice?.Number · @invoice?.Supplier?.Name</p></div></div>
<div class="alert alert-info">Invoice total: PKR @invoice?.GrandTotal.ToString("N2") · Outstanding: PKR @outstanding.ToString("N2")</div>
<form method="post" asp-action="RecordPaymentForm"><input asp-for="PurchaseInvoiceId" type="hidden"/><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><section class="content-card mb-4"><div class="row g-3"><div class="col-md-4"><label asp-for="PaymentDate" class="form-label">Payment date</label><input asp-for="PaymentDate" type="date" class="form-control"/></div><div class="col-md-4"><label asp-for="Amount" class="form-label">Amount</label><input asp-for="Amount" type="number" min="0.01" max="@outstanding" step="0.01" class="form-control"/><span asp-validation-for="Amount" class="text-danger"></span></div><div class="col-md-4"><label asp-for="PaymentMethod" class="form-label">Payment method</label><select asp-for="PaymentMethod" asp-items="Html.GetEnumSelectList<ManufacturerERP.Models.PaymentMethod>()" class="form-select"></select></div><div class="col-md-6"><label asp-for="ReferenceNumber" class="form-label">Reference number</label><input asp-for="ReferenceNumber" class="form-control"/></div><div class="col-md-6"><label asp-for="Notes" class="form-label">Notes</label><input asp-for="Notes" class="form-control"/></div></div></section><button class="btn btn-primary" disabled="@(outstanding<=0)">Record payment</button> <a asp-action="Invoices" class="btn btn-link">Cancel</a></form>
