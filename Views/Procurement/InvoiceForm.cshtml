@model ManufacturerERP.Models.PurchaseInvoice
@{ ViewData["Title"]="New Purchase Invoice"; var suppliers=ViewBag.Suppliers as IEnumerable<ManufacturerERP.Models.Supplier> ?? []; var warehouses=ViewBag.Warehouses as IEnumerable<ManufacturerERP.Models.Warehouse> ?? []; var products=ViewBag.Products as IEnumerable<ManufacturerERP.Models.Product> ?? []; var orders=ViewBag.PurchaseOrders as IEnumerable<ManufacturerERP.Models.PurchaseOrder> ?? []; }
<div class="page-heading"><div><span class="eyebrow">PROCUREMENT</span><h1>New Purchase Invoice</h1><p>Confirming an invoice creates a payable, not inventory.</p></div></div>
<form method="post" asp-action="CreateInvoiceForm"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><section class="content-card mb-4"><div class="row g-3"><div class="col-md-3"><label asp-for="SupplierId" class="form-label">Supplier</label><select asp-for="SupplierId" class="form-select"><option value="">Select supplier</option>@foreach(var supplier in suppliers){<option value="@supplier.Id">@supplier.Name</option>}</select><span asp-validation-for="SupplierId" class="text-danger"></span></div><div class="col-md-3"><label asp-for="SupplierInvoiceNumber" class="form-label">Supplier invoice number</label><input asp-for="SupplierInvoiceNumber" class="form-control" required/><span asp-validation-for="SupplierInvoiceNumber" class="text-danger"></span></div><div class="col-md-3"><label asp-for="InvoiceDate" class="form-label">Invoice date</label><input asp-for="InvoiceDate" type="date" class="form-control"/></div><div class="col-md-3"><label asp-for="DueDate" class="form-label">Due date</label><input asp-for="DueDate" type="date" class="form-control"/></div><div class="col-md-6"><label asp-for="PurchaseOrderId" class="form-label">Purchase order (optional)</label><select asp-for="PurchaseOrderId" class="form-select"><option value="">Not linked to an order</option>@foreach(var order in orders){<option value="@order.Id">@order.Number · @order.Status</option>}</select><span asp-validation-for="PurchaseOrderId" class="text-danger"></span></div><div class="col-md-6"><label asp-for="WarehouseId" class="form-label">Warehouse (optional)</label><select asp-for="WarehouseId" class="form-select"><option value="">Select warehouse</option>@foreach(var warehouse in warehouses){<option value="@warehouse.Id">@warehouse.Name</option>}</select></div><div class="col-md-4"><label asp-for="Discount" class="form-label">Invoice discount</label><input asp-for="Discount" type="number" min="0" step="0.01" class="form-control"/></div><div class="col-md-4"><label asp-for="Tax" class="form-label">Invoice tax</label><input asp-for="Tax" type="number" min="0" step="0.01" class="form-control"/></div><div class="col-12"><label asp-for="Notes" class="form-label">Notes</label><textarea asp-for="Notes" class="form-control"></textarea></div></div></section>
<section class="content-card mb-4"><div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h5 mb-0">Invoice items</h2><button type="button" id="addLine" class="btn btn-outline-primary btn-sm">Add item</button></div><div asp-validation-for="Items" class="text-danger"></div><div id="items">@for(var i=0;i<Model.Items.Count;i++){<div class="row g-2 mb-2 item-row"><div class="col-md-5"><label class="form-label">Item</label><select name="Items[@i].ProductId" class="form-select" required><option value="">Select item</option>@foreach(var product in products){<option value="@product.Id" selected="@(product.Id==Model.Items[i].ProductId)">@product.Code · @product.Name (@product.Unit?.ShortCode)</option>}</select></div><div class="col-md-2"><label class="form-label">Quantity</label><input name="Items[@i].Quantity" value="@Model.Items[i].Quantity" type="number" min="0.001" step="0.001" class="form-control" required/></div><div class="col-md-2"><label class="form-label">Unit price</label><input name="Items[@i].UnitPrice" value="@Model.Items[i].UnitPrice" type="number" min="0" step="0.01" class="form-control" required/></div><div class="col-md-2"><label class="form-label">Discount</label><input name="Items[@i].Discount" value="@Model.Items[i].Discount" type="number" min="0" step="0.01" class="form-control"/></div><div class="col-md-1 d-flex align-items-end"><button type="button" class="btn btn-outline-secondary remove-line">Remove</button></div></div>}</div></section><button class="btn btn-primary">Create draft invoice</button> <a asp-action="Invoices" class="btn btn-link">Cancel</a></form>
@section Scripts { <script>
const productOptions=`@Html.Raw(string.Join("",products.Select(p=>$"<option value=\"{p.Id}\">{System.Net.WebUtility.HtmlEncode(p.Code)} · {System.Net.WebUtility.HtmlEncode(p.Name)} ({System.Net.WebUtility.HtmlEncode(p.Unit?.ShortCode ?? "")})</option>")))`;
function reindex(){document.querySelectorAll('#items .item-row').forEach((row,index)=>row.querySelectorAll('[name]').forEach(input=>input.name=input.name.replace(/Items\[\d+\]/,`Items[${index}]`)));}
document.querySelector('#addLine').addEventListener('click',()=>{const index=document.querySelectorAll('#items .item-row').length;document.querySelector('#items').insertAdjacentHTML('beforeend',`<div class="row g-2 mb-2 item-row"><div class="col-md-5"><label class="form-label">Item</label><select name="Items[${index}].ProductId" class="form-select" required><option value="">Select item</option>${productOptions}</select></div><div class="col-md-2"><label class="form-label">Quantity</label><input name="Items[${index}].Quantity" type="number" min="0.001" step="0.001" class="form-control" required/></div><div class="col-md-2"><label class="form-label">Unit price</label><input name="Items[${index}].UnitPrice" type="number" min="0" step="0.01" class="form-control" required/></div><div class="col-md-2"><label class="form-label">Discount</label><input name="Items[${index}].Discount" value="0" type="number" min="0" step="0.01" class="form-control"/></div><div class="col-md-1 d-flex align-items-end"><button type="button" class="btn btn-outline-secondary remove-line">Remove</button></div></div>`);});
document.querySelector('#items').addEventListener('click',event=>{if(event.target.closest('.remove-line')){event.target.closest('.item-row').remove();reindex();}});
</script> }
