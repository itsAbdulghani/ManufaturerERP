@model ManufacturerERP.Models.GoodsReceipt
@{ ViewData["Title"]="Goods Receipt"; }
<div class="page-heading"><div><span class="eyebrow">PROCUREMENT</span><h1>Receive Purchase Order</h1><p>Only confirmed receipts post warehouse stock.</p></div></div>
<form method="post" asp-action="CreateReceiptForm"><input asp-for="PurchaseOrderId" type="hidden"/><div asp-validation-summary="All" class="alert alert-danger"></div><section class="content-card mb-4"><div class="row g-3"><div class="col-md-4"><label asp-for="ReceiptDate" class="form-label">Receipt date</label><input asp-for="ReceiptDate" type="date" class="form-control"/></div><div class="col-md-4"><label asp-for="SupplierDeliveryNoteNumber" class="form-label">Supplier delivery note</label><input asp-for="SupplierDeliveryNoteNumber" class="form-control"/></div><div class="col-md-4"><label asp-for="Notes" class="form-label">Notes</label><input asp-for="Notes" class="form-control"/></div></div></section>
<section class="content-card mb-4"><h2 class="h5">Open order quantities</h2><div asp-validation-for="Items" class="text-danger"></div>@if(Model.Items.Count==0){<p class="text-muted">There are no open quantities to receive.</p>}<div class="table-responsive"><table class="table"><thead><tr><th>Product</th><th>Ordered</th><th>Previously received</th><th>Open</th><th>Receive now</th></tr></thead><tbody>@for(var i=0;i<Model.Items.Count;i++){var line=Model.Items[i];<tr><td>@line.Product?.Name<input type="hidden" name="Items[@i].PurchaseOrderItemId" value="@line.PurchaseOrderItemId"/></td><td>@line.OrderedQuantity</td><td>@line.PreviouslyReceivedQuantity</td><td>@(line.OrderedQuantity-line.PreviouslyReceivedQuantity)</td><td><input asp-for="Items[i].ReceivingQuantity" type="number" min="0" max="@(line.OrderedQuantity-line.PreviouslyReceivedQuantity)" step="0.001" class="form-control" />
<span class="text-danger" asp-validation-for="Items[@i].ReceivingQuantity"></span></td></tr>}</tbody></table></div></section><button class="btn btn-primary" disabled="@(Model.Items.Count==0)">Save draft receipt</button> <a asp-action="OrderDetails" asp-route-id="@Model.PurchaseOrderId" class="btn btn-link">Cancel</a></form>
