@model IEnumerable<ManufacturerERP.Models.InventoryTransaction>
@{ViewData["Title"]="Raw Material Inventory"; var balances=Model.GroupBy(x=>new {x.ProductId,x.WarehouseId,x.Product,x.Warehouse}).Select(g=>new {g.Key.Product,g.Key.Warehouse,Quantity=g.Sum(x=>x.Quantity)});}
<h2 class="mb-4">Raw Material Inventory</h2><div class="card mb-4"><table class="table mb-0"><thead><tr><th>Product</th><th>SKU</th><th>Unit</th><th>Warehouse</th><th>Current quantity</th><th>Status</th></tr></thead><tbody>@foreach(var row in balances){var state=row.Quantity<=0?"Out of Stock":row.Quantity<=(row.Product?.MinimumStockLevel??0)?"Low Stock":"Normal";<tr><td>@row.Product?.Name</td><td>@row.Product?.Code</td><td>@row.Product?.Unit?.ShortCode</td><td>@row.Warehouse?.Name</td><td>@row.Quantity</td><td>@state</td></tr>}</tbody></table></div><h5>Stock Movement</h5><div class="card"><table class="table mb-0"><thead><tr><th>Date</th><th>Product</th><th>Warehouse</th><th>Type</th><th>In</th><th>Out</th><th>Reference</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.TransactionDate</td><td>@x.Product?.Name</td><td>@x.Warehouse?.Name</td><td>@x.TransactionType</td><td>@(x.Quantity>0?x.Quantity:0)</td><td>@(x.Quantity<0?-x.Quantity:0)</td><td>@x.ReferenceType #@x.ReferenceId</td></tr>}</tbody></table></div>
