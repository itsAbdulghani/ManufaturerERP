@model IEnumerable<ManufacturerERP.Models.UserListItemViewModel>
@{ViewData["Title"]="Users & Roles";}
<div class="d-flex justify-content-between align-items-center mb-4"><div><h2>Users &amp; Roles</h2><p class="text-muted mb-0">Existing Identity roles: Admin, Manager, Storekeeper, Sales, Purchase, Accountant, Production.</p></div><a asp-action="CreateUser" class="btn btn-primary">Create user</a></div>
@if(TempData["Success"] is string success){<div class="alert alert-success">@success</div>}@if(TempData["Error"] is string error){<div class="alert alert-danger">@error</div>}
<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Name</th><th>Email / Username</th><th>Phone</th><th>Role</th><th>Status</th><th>Created</th><th>Actions</th></tr></thead><tbody>@foreach(var row in Model){<tr><td>@row.User.FullName</td><td>@row.User.Email</td><td>@row.User.PhoneNumber</td><td>@row.Roles</td><td><span class="badge @(row.User.IsActive?"text-bg-success":"text-bg-secondary")">@(row.User.IsActive?"Active":"Inactive")</span></td><td>@row.User.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td><td class="text-nowrap"><a asp-action="EditUser" asp-route-id="@row.User.Id" class="btn btn-sm btn-outline-primary">Edit</a><form method="post" asp-action="ToggleUser" asp-route-id="@row.User.Id" class="d-inline"><button class="btn btn-sm btn-outline-secondary">@(row.User.IsActive?"Deactivate":"Activate")</button></form></td></tr>}</tbody></table></div></div>
