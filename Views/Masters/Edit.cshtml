@model ManufacturerERP.Models.MasterRecord
@{var type=(string)ViewBag.Type; var editing=Model.Id>0; ViewData["Title"]=(editing?"Edit ":"New ")+type.TrimEnd('s'); var units=ViewBag.Units as IEnumerable<ManufacturerERP.Models.Unit>;}
<div class="mb-4"><a class="text-decoration-none" href="/Masters/@type">← Back to @type</a><h2 class="mt-2">@ViewData["Title"]</h2></div>
<form method="post" class="card"><div class="card-body"><div asp-validation-summary="ModelOnly" class="text-danger"></div>
@if(Model is ManufacturerERP.Models.Unit u){<div class="row g-3"><div class="col-md-6"><label>Name</label><input name="Name" value="@u.Name" class="form-control" required /></div><div class="col-md-6"><label>Short code</label><input name="ShortCode" value="@u.ShortCode" class="form-control" required /></div><div class="col-12"><label>Description</label><textarea name="Description" class="form-control">@u.Description</textarea></div></div>}
@if(Model is ManufacturerERP.Models.Warehouse w){<div class="row g-3"><div class="col-md-6"><label>Name</label><input name="Name" value="@w.Name" class="form-control" required /></div><div class="col-md-6"><label>Code</label><input name="Code" value="@w.Code" class="form-control" required /></div><div class="col-md-6"><label>City</label><input name="City" value="@w.City" class="form-control" /></div><div class="col-md-6"><label>Address</label><input name="Address" value="@w.Address" class="form-control" /></div><div class="col-12"><label>Description</label><textarea name="Description" class="form-control">@w.Description</textarea></div></div>}
@if(Model is ManufacturerERP.Models.Product p){<div class="row g-3"><div class="col-md-4"><label>SKU / Code</label><input name="Code" value="@p.Code" class="form-control" required /></div><div class="col-md-8"><label>Product name</label><input name="Name" value="@p.Name" class="form-control" required /></div><div class="col-md-4"><label>Item type</label><select name="ItemType" class="form-select">@foreach(var t in Enum.GetValues<ManufacturerERP.Models.ItemType>()){<option selected="@(p.ItemType==t)" value="@t">@t</option>}</select></div><div class="col-md-4"><label>Unit</label><select name="UnitId" class="form-select" required><option value="">Select unit</option>@foreach(var unit in units!){<option selected="@(p.UnitId==unit.Id)" value="@unit.Id">@unit.Name (@unit.ShortCode)</option>}</select></div><div class="col-md-4"><label>Minimum stock</label><input type="number" min="0" step=".001" name="MinimumStockLevel" value="@p.MinimumStockLevel" class="form-control" /></div><div class="col-md-6"><label>Purchase price (PKR)</label><input type="number" min="0" step=".01" name="PurchasePrice" value="@p.PurchasePrice" class="form-control" /></div><div class="col-md-6"><label>Sale price (PKR)</label><input type="number" min="0" step=".01" name="SalePrice" value="@p.SalePrice" class="form-control" /></div><div class="col-12"><label>Description</label><textarea name="Description" class="form-control">@p.Description</textarea></div></div>}
@if(Model is ManufacturerERP.Models.Party party){<div class="row g-3"><div class="col-md-4"><label>Code</label><input name="Code" value="@party.Code" class="form-control" required /></div><div class="col-md-8"><label>Name</label><input name="Name" value="@party.Name" class="form-control" required /></div><div class="col-md-4"><label>Contact person</label><input name="ContactPerson" value="@party.ContactPerson" class="form-control" /></div><div class="col-md-4"><label>Phone</label><input name="Phone" value="@party.Phone" class="form-control" /></div><div class="col-md-4"><label>Email</label><input type="email" name="Email" value="@party.Email" class="form-control" /></div><div class="col-md-4"><label>City</label><input name="City" value="@party.City" class="form-control" /></div><div class="col-md-4"><label>Province</label><input name="Province" value="@party.Province" class="form-control" /></div><div class="col-md-4"><label>Payment terms (days)</label><input type="number" min="0" name="PaymentTerms" value="@party.PaymentTerms" class="form-control" /></div>@if(party is ManufacturerERP.Models.Customer c){<div class="col-md-4"><label>Credit limit (PKR)</label><input type="number" min="0" step=".01" name="CreditLimit" value="@c.CreditLimit" class="form-control" /></div>}<div class="col-md-4"><label>NTN</label><input name="NTN" value="@party.NTN" class="form-control" /></div><div class="col-md-4"><label>STRN</label><input name="STRN" value="@party.STRN" class="form-control" /></div><div class="col-12"><label>Address</label><textarea name="Address" class="form-control">@party.Address</textarea></div><div class="col-12"><label>Notes</label><textarea name="Notes" class="form-control">@party.Notes</textarea></div></div>}
<div class="form-check mt-4"><input type="hidden" name="IsActive" value="false" /><input class="form-check-input" type="checkbox" name="IsActive" value="true" checked="@Model.IsActive" id="active" /><label class="form-check-label" for="active">Active</label></div></div><div class="card-footer text-end"><a href="/Masters/@type" class="btn btn-light">Cancel</a><button class="btn btn-primary">Save</button></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
