@model IEnumerable<ManufacturerERP.Models.MasterRecord>
@{ var type=(string)ViewBag.Type; ViewData["Title"]=ViewBag.Title; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><h2>@ViewBag.Title</h2><p class="text-muted mb-0">Manage your @type master data</p></div><a class="btn btn-primary" href="/Masters/@type/create">+ Add @ViewBag.Title.TrimEnd('s')</a></div>
<form class="card card-body mb-3" method="get"><input name="search" value="@Context.Request.Query["search"]" class="form-control" placeholder="Search by name or code" /></form>
<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Code</th><th>Name</th><th>Details</th><th>Status</th><th class="text-end">Actions</th></tr></thead><tbody>@foreach(var row in Model){var code=row switch { ManufacturerERP.Models.Unit x=>x.ShortCode, ManufacturerERP.Models.Warehouse x=>x.Code, ManufacturerERP.Models.Product x=>x.Code, ManufacturerERP.Models.Party x=>x.Code,_=>""};var name=row switch { ManufacturerERP.Models.Unit x=>x.Name, ManufacturerERP.Models.Warehouse x=>x.Name, ManufacturerERP.Models.Product x=>x.Name, ManufacturerERP.Models.Party x=>x.Name,_=>""};var details=row is ManufacturerERP.Models.Product p ? $"{p.ItemType} · {p.Unit?.ShortCode}" : row is ManufacturerERP.Models.Party a ? a.Phone : row is ManufacturerERP.Models.Warehouse w ? w.City : "";<tr><td><code>@code</code></td><td class="fw-semibold">@name</td><td class="text-muted">@details</td><td><span class="badge @(row.IsActive?"text-bg-success":"text-bg-secondary")">@(row.IsActive?"Active":"Inactive")</span></td><td class="text-end"><a class="btn btn-sm btn-outline-primary" href="/Masters/@type/@row.Id/edit">Edit</a><form class="d-inline" method="post" action="/Masters/@type/@row.Id/toggle">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-secondary" onclick="return confirm('Change this record status?')">@(row.IsActive?"Deactivate":"Activate")</button></form></td></tr>}</tbody></table></div></div>
